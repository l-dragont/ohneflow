# --- Database (Neon / Supabase / local Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ohneflow?sslmode=require"

# --- Auth (NextAuth, JWT sessions) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate: openssl rand -base64 32"

# --- Encryption for stored OAuth tokens (AES-256-GCM, 32 bytes base64) ---
TOKEN_ENCRYPTION_KEY="generate: openssl rand -base64 32"

# --- Google Classroom OAuth (Google Cloud Console) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# --- AI provider (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=""

# --- Email reminders (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="ohneflow <reminders@yourdomain.com>"

# --- Rate limiting (Upstash Redis; falls back to in-memory in dev) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cron (protects /api/cron/* on Vercel) ---
CRON_SECRET="generate: openssl rand -hex 24"

# --- Feature flags ---
JUPITER_ENABLED="false"

# Optional: override the AI model
AI_MODEL="claude-sonnet-5-5"
JUPITER_API_BASE=""   # only if JupiterEd grants official API access
