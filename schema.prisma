// ohneflow database schema (PostgreSQL via Prisma)
// All user-owned tables carry userId so every query can be scoped to the owner.

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}
enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
}
enum Source {
  MANUAL
  GOOGLE_CLASSROOM
  JUPITER
}
enum ReminderChannel {
  IN_APP
  EMAIL
}
enum SyncStatus {
  IDLE
  SYNCING
  OK
  ERROR
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String                       // argon2/bcrypt hash, never plaintext
  role          Role     @default(STUDENT)
  theme         String   @default("system")
  timezone      String   @default("UTC")
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subjects      Subject[]
  assignments   Assignment[]
  notes         Note[]
  grades        Grade[]
  studySessions StudySession[]
  badges        UserBadge[]
  notifications Notification[]
  aiThreads     AiThread[]
  resetTokens   PasswordResetToken[]
  google        GoogleClassroomConnection?
  jupiter       JupiterConnection?
}

model Subject {
  id         String   @id @default(cuid())
  userId     String
  name       String
  color      String   @default("#6366f1")
  icon       String   @default("book")
  teacher    String?
  classroom  String?
  source     Source   @default(MANUAL)
  externalId String?                         // Google Classroom courseId
  createdAt  DateTime @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  notes       Note[]
  grades      Grade[]
  @@unique([userId, source, externalId])
  @@index([userId])
}

model Assignment {
  id               String           @id @default(cuid())
  userId           String
  subjectId        String
  title            String
  description      String?
  notes            String?
  dueDate          DateTime?
  status           AssignmentStatus @default(NOT_STARTED)
  priority         Priority         @default(MEDIUM)
  estimatedMinutes Int?
  completedAt      DateTime?
  source           Source           @default(MANUAL)
  externalId       String?                   // Classroom courseWork id
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  reminders   Reminder[]
  linkedNotes Note[]
  roadmap     AiRoadmap?
  @@unique([userId, source, externalId])
  @@index([userId, dueDate])
  @@index([subjectId, status])
}

model Attachment {
  id           String   @id @default(cuid())
  assignmentId String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String                        // object-storage key (S3/R2/Vercel Blob)
  createdAt    DateTime @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model Reminder {
  id            String          @id @default(cuid())
  assignmentId  String
  remindAt      DateTime
  offsetMinutes Int?                         // e.g. 1440 = 1 day before
  channel       ReminderChannel @default(IN_APP)
  sentAt        DateTime?
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  @@index([remindAt, sentAt])
}

model Note {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  assignmentId String?
  title        String
  content      String                        // markdown, sanitized on render
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  @@index([userId, pinned])
}

model Grade {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String
  title        String?
  score        Float
  maxScore     Float    @default(100)
  percentage   Float                         // computed on write
  source       Source   @default(MANUAL)     // MANUAL now, JUPITER later
  externalId   String?
  dateRecorded DateTime @default(now())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([userId, subjectId, dateRecorded])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?
  type      String                            // WORK | BREAK
  minutes   Int
  startedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
}

model Badge {
  id          String @id @default(cuid())
  key         String @unique                  // e.g. "streak_7", "assignments_50"
  name        String
  description String
  users       UserBadge[]
}
model UserBadge {
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@id([userId, badgeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model AiThread {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?                           // context the chat was opened in
  createdAt DateTime @default(now())
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
}
model AiMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String                            // user | assistant
  content   String
  createdAt DateTime @default(now())
  thread AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}
model AiRoadmap {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  steps        Json                           // [{title, minutes, tip}]
  firstSteps   String
  totalMinutes Int
  timeline     Json
  createdAt    DateTime @default(now())
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model GoogleClassroomConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  googleAccountEmail    String
  accessTokenEnc        String                // AES-256-GCM encrypted
  refreshTokenEnc       String
  scopes                String                // read-only classroom scopes
  syncStatus            SyncStatus @default(IDLE)
  lastSyncedAt          DateTime?
  lastError             String?
  connectedAt           DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JupiterConnection {
  id               String   @id @default(cuid())
  userId           String   @unique
  accountReference String
  syncStatus       SyncStatus @default(IDLE)
  lastSyncedAt     DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique               // sha256 of the emailed token; the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
